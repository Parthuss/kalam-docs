# Neon Postgres — pooled connection (hostname contains "-pooler"), used at runtime
DATABASE_URL="postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres — direct connection (no "-pooler"), used by Prisma Migrate/seed
DIRECT_DATABASE_URL="postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres — direct connection to a separate "test" branch, used only by the test suite
TEST_DATABASE_URL="postgres://user:pass@ep-yyy.region.aws.neon.tech/neondb?sslmode=require"

# Any long random string, e.g. `openssl rand -base64 32`
SESSION_SECRET="change-me-to-a-random-32-byte-string"
